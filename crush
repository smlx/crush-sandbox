#!/bin/bash
set -euo pipefail

red='\033[0;31m'
green='\033[0;32m'
yellow='\033[0;33m'
cyan='\033[0;36m'
dim='\033[2m'
bold='\033[1m'
reset='\033[0m'

# bind mounting home would expose sensitive credentials and dotfiles
[ "$(realpath "$PWD")" = "$(realpath "$HOME")" ] && echo -e "${red}🛑 Not starting crush in $HOME.${reset}" && exit 1

KEY_CONFIGS=(
	"GEMINI_API_KEY:gemini_api_key_command:Gemini API Key:LLM Providers:"
	"AMAZEEAI_API_KEY:amazeeai_api_key_command:amazee.ai API Key:LLM Providers:"
	"HYPER_API_KEY:hyper_api_key_command:Hyper API Key:LLM Providers:"
	"GITHUB_PAT:github_pat_command:GitHub PAT:Other Credentials:"
)

interactive_menu() {
	while true; do
		echo ""
		printf " %-2s %-21s %-11s %s\n" "#" "Variable" "Status" "Generator Command"
		echo "────────────────────────────────────────────────────────────────────────"

		local idx=1
		local current_category=""

		for item in "${KEY_CONFIGS[@]}"; do
			IFS=":" read -r var_name cmd_func label category <<< "$item"

			if [ "$category" != "$current_category" ]; then
				[ "$current_category" != "" ] && echo ""
				echo -e "${bold}${category}${reset}"
				current_category="$category"
			fi

			local var_status="${yellow}[UNSET]${reset}"
			if [ -v "$var_name" ] && [ "${!var_name}" != "" ]; then
				var_status="${green}[ SET ]${reset}"
			fi

			local cmd_status="${dim}-- none --${reset}"
			if declare -F "$cmd_func" >/dev/null; then
				cmd_status="${cyan}${cmd_func}${reset}"
			fi

			printf " %-2d %-21s %b     %b\n" "$idx" "$label" "$var_status" "$cmd_status"
			((idx++))
		done

		echo ""
		read -rp "👉 Press [Enter] to start crush, [1-$((idx-1))] to run command, [q] to quit: " choice

		case "$choice" in
			"")
				break
				;;
			[qQ])
				echo "Aborted."
				exit 0
				;;
			[1-9])
				if [ "$choice" -ge 1 ] && [ "$choice" -le "${#KEY_CONFIGS[@]}" ]; then
					local selected="${KEY_CONFIGS[$((choice-1))]}"
					IFS=":" read -r var_name cmd_func label category <<< "$selected"

					if declare -F "$cmd_func" >/dev/null; then
						echo -e "\nExecuting function ${cyan}$cmd_func${reset}:"
						type "$cmd_func"
						local val
						val="$("$cmd_func")"
						printf -v "$var_name" '%s' "$val"
						export "${var_name?}"
						echo -e "${green}✅ Updated $var_name${reset}"
					else
						echo -e "\n${red}⚠️ Function '$cmd_func' is not defined.${reset}"
					fi
				else
					echo -e "${red}Invalid option.${reset}"
				fi
				;;
			*)
				echo -e "${red}Invalid option.${reset}"
				;;
		esac
	done
}

interactive_menu

ENV_ARGS=()
for item in "${KEY_CONFIGS[@]}"; do
	IFS=":" read -r var_name _ _ _ <<< "$item"
	if [ -v "$var_name" ] && [ "${!var_name}" != "" ]; then
		ENV_ARGS+=("--setenv=${var_name}=${!var_name}")
	fi
done

EXTRA_BINDS=()
for path in "$@"; do
	EXTRA_BINDS+=("--property=BindReadOnlyPaths=$(realpath "$path")")
done

SESSION_ID="$(basename "$PWD")-$RANDOM"
UNIT_NAME="crush-sandbox-${SESSION_ID}"
PROXY_UNIT="crush-proxy@${SESSION_ID}"
PROXY_BUS="/run/user/$UID/crush-sandbox-${SESSION_ID}-bus/bus"

# execute crush in a sandbox
# see: man systemd-run systemd.exec systemd.resource-control
exec systemd-run \
	--collect \
	--pty \
	--same-dir \
	"${ENV_ARGS[@]}" \
	--setenv=APPIMAGE_EXTRACT_AND_RUN=1 \
	--setenv=EDITOR="${EDITOR:-}" \
	--setenv=PATH="$PATH" \
	--setenv=SSH_AUTH_SOCK="${SSH_AUTH_SOCK:-}" \
	--unit="$UNIT_NAME" \
	--user \
	--property=Requires="${PROXY_UNIT}.service" \
	--property=After="${PROXY_UNIT}.service" \
	--property=BindPaths="$HOME/.ansible" \
	--property=BindPaths="$HOME/.cache" \
	--property=BindPaths="$HOME/.config/crush" \
	--property=BindPaths="$HOME/.docker" \
	--property=BindPaths="$HOME/.local/share/crush" \
	--property=BindPaths="$HOME/.local/share/nvim" \
	--property=BindPaths="$HOME/.local/state/crush" \
	--property=BindPaths="$HOME/.local/state/nvim" \
	--property=BindPaths="$HOME/go" \
	--property=BindPaths="$PWD" \
	--property=BindPaths="$SSH_AUTH_SOCK" \
	--property=BindPaths="$PROXY_BUS:/run/user/$UID/bus" \
	--property=BindReadOnlyPaths="$HOME/.config/git" \
	--property=BindReadOnlyPaths="$HOME/.config/nvim" \
	--property=CapabilityBoundingSet= \
	--property=LockPersonality=true \
	--property=NoNewPrivileges=true \
	--property=PrivateDevices=true \
	--property=PrivateIPC=true \
	--property=PrivateTmp=true \
	--property=PrivateUsers=true \
	--property=ProtectClock=true \
	--property=ProtectControlGroups=true \
	--property=ProtectHome=tmpfs \
	--property=ProtectKernelLogs=true \
	--property=ProtectKernelModules=true \
	--property=ProtectKernelTunables=true \
	--property=ProtectSystem=strict \
	--property=RestrictNamespaces=true \
	--property=RestrictRealtime=true \
	--property=RestrictSUIDSGID=true \
	--property=SystemCallArchitectures=native \
	--property=SystemCallErrorNumber=EPERM \
	--property=SystemCallFilter=@system-service \
	"${EXTRA_BINDS[@]}" \
	/usr/local/libexec/crush --debug
